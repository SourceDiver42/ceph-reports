{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ceph-reports values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "toolboxAccess": {
          "type": "object",
          "properties": { "create": { "type": "boolean" } }
        }
      }
    },
    "smtp": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "user": { "type": "string" },
            "pass": { "type": "string" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        "secret": {
          "type": "object",
          "properties": { "create": { "type": "boolean" } }
        }
      }
    },
    "mail": {
      "type": "object",
      "properties": {
        "subjectPrefix": { "type": "string" },
        "clusterName": { "type": "string" },
        "clusterNameFrom": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "configMap": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "namespace": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "podLabels": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "daily": { "$ref": "#/definitions/job" },
    "weekly": {
      "allOf": [
        { "$ref": "#/definitions/job" },
        {
          "type": "object",
          "properties": {
            "ceph": {
              "type": "object",
              "properties": {
                "mode": { "type": "string", "enum": ["toolbox", "client"] },
                "rbdPools": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "cephfs": {
                  "type": "object",
                  "properties": {
                    "names": { "type": "array", "items": { "type": "string" } },
                    "subvolumeGroup": { "type": "string" }
                  }
                },
                "toolbox": {
                  "type": "object",
                  "properties": {
                    "namespace": { "type": "string" },
                    "target": { "type": "string" }
                  }
                },
                "client": {
                  "type": "object",
                  "properties": {
                    "image": { "type": "object" },
                    "user": { "type": "string" },
                    "keyringPath": { "type": "string" },
                    "keyringSecret": { "type": "string" },
                    "keyringSecretKey": { "type": "string" },
                    "monHost": { "type": "string" },
                    "monEndpointsNamespace": { "type": "string" },
                    "monEndpointsConfigMap": { "type": "string" }
                  }
                }
              },
              "required": ["mode"],
              "allOf": [
                {
                  "if": { "properties": { "mode": { "const": "client" } } },
                  "then": { "required": ["client"] }
                },
                {
                  "if": { "properties": { "mode": { "const": "toolbox" } } },
                  "then": { "required": ["toolbox"] }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "job": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "timeZone": { "type": "string" },
        "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "suspend": { "type": "boolean" },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "podLabels": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array" }
      }
    }
  }
}
